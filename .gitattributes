# PDFs are binary -- CRLF conversion corrupts them outright.
*.pdf   binary

# DXF is plain text but SendCutSend gets the bytes as written (R12, CRLF).
# Keep them out of the line-ending machinery entirely.
*.dxf   -text

*.xlsx  binary
*.stl   binary
*.png   binary
*.jpg   binary

# Source: normalise to LF in the repo, whatever the working copy does.
*.py    text eol=lf
*.rb    text eol=lf
*.md    text eol=lf
*.html  text eol=lf
